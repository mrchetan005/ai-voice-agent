# voiceagent environment template
#
# Copy to .env and fill ONLY the keys your provider string uses:
#   cp .env.example .env
# Run with it loaded (uv does not auto-load .env):
#   uv run --env-file .env examples/quickstart.py
# Or set once per shell:  export UV_ENV_FILE=.env

# --- Provider API keys (fill what you use) ---------------------------------

# provider="openai-realtime"  (also the "openai" LLM part of a split stack)
OPENAI_API_KEY=

# provider="gemini-live"
GOOGLE_API_KEY=

# split-stack ASR: "deepgram" / "deepgram-flux"
DEEPGRAM_API_KEY=

# split-stack LLM preset: "groq"
GROQ_API_KEY=

# split-stack TTS: "cartesia"
CARTESIA_API_KEY=

# split-stack TTS: "elevenlabs"
ELEVENLABS_API_KEY=

# --- Appointment booker (src/appointment_booker) ------------------------

# Meta WhatsApp Cloud API (Business Calling)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECIPIENT=            # E.164 without +, e.g. 91XXXXXXXXXX
WHATSAPP_VERIFY_TOKEN=voiceagent   # must match Meta App dashboard webhook config

# Cal.com
CAL_API_KEY=
CAL_EVENT_TYPE_ID=             # find via: uv run --env-file .env python -m appointment_booker.cal_client
CAL_TIMEZONE=Asia/Kolkata

# Scheduler LLM (LangGraph; defaults to gemini-3.6-flash on GOOGLE_API_KEY)
# SCHEDULER_MODEL=gemini-3.6-flash

# Post-call recap (WhatsApp message after every meaningful call)
# RECAP_MIN_USER_TURNS=2          # calls with fewer user turns get no recap
# RECAP_MODEL=gemini-3.6-flash    # defaults to SCHEDULER_MODEL

# --- Observability (GET /report + /costs on the webhook server) ---------
METRICS_TOKEN=                    # bearer token; unset = endpoints answer 404
# JUDGE_MODEL=gemini-3.6-flash    # hallucination audit (python -m appointment_booker.audit)
# WHATSAPP_MSG_COST_USD=0         # per-message estimate (0 inside 24h window)
# Per-unit price overrides in USD — see src/appointment_booker/pricing.py:
# PRICE_GEMINI_LIVE_PROMPT_TOKENS_AUDIO=
# PRICE_GEMINI_LIVE_RESPONSE_TOKENS_AUDIO=
# PRICE_GEMINI_FLASH_INPUT_TOKENS=
# PRICE_DEEPGRAM_AUDIO_SECONDS=

# Conversation state (LangGraph checkpointer -> Neon/any Postgres)
DATABASE_URL=
# Spoken business identity for the agent persona
BUSINESS_NAME=

# --- Optional session defaults (read by SessionConfig.from_env()) ----------

# VOICEAGENT_LANGUAGE=hi-IN
# VOICEAGENT_TONE=warm
# VOICEAGENT_SYSTEM_PROMPT=You are a helpful assistant for my ops team.
# Cartesia voices: Rohan (male) 4877b818-c7fe-4c89-b1cf-eadf8e23da72,
#                  Kavita (female) 56e35e2d-6eb6-4226-ab8b-9776515a7094
# VOICEAGENT_VOICE_ID=
# VOICEAGENT_GUARDRAIL_PROFILE=standard   # off | standard | strict

# Free-form provider knobs -> SessionConfig.provider_options
# VOICEAGENT_OPT_MODEL=gpt-realtime-2.1-mini
# VOICEAGENT_OPT_LLM_MODEL=openai/gpt-oss-20b
# VOICEAGENT_OPT_TTS_VOICE=
