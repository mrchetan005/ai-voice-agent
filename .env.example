# voiceagent configuration template. Copy to .env and fill in what you use.
# Secrets are env-only: never commit a real .env.

# --- LiveKit (self-hosted server) -------------------------------------------
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
# LiveKit requires API secrets to be at least 32 characters.
LIVEKIT_API_SECRET=devsecret_devsecret_devsecret_123456

# --- Platform control-plane API ---------------------------------------------
PLATFORM_API_TOKEN=devtoken
PLATFORM_PORT=8080
PLATFORM_DATABASE_URL=postgresql://voiceagent:voiceagent@localhost:5432/voiceagent
PLATFORM_REDIS_URL=redis://localhost:6379/0

# --- Worker -------------------------------------------------------------------
WORKER_PROMETHEUS_PORT=9100
WORKER_IDLE_PROCESSES=2
WORKER_LOAD_THRESHOLD=0.7
WORKER_DRAIN_TIMEOUT_S=600

# --- Agent discovery (either one) --------------------------------------------
# Comma-separated module paths to VoiceAgent objects:
#   VOICEAGENT_AGENTS=examples.agents.sales_pipeline:agent,examples.agents.mock_demo:agent
VOICEAGENT_AGENTS=
# Or a YAML file of agent configs (see examples/agents.yaml):
VOICEAGENT_AGENTS_FILE=examples/agents.yaml

# --- Provider API keys (only for the providers you configure) ----------------
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVEN_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# --- Observability ------------------------------------------------------------
# OTLP endpoint for traces, e.g. http://localhost:4317 (empty = tracing off)
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=true

# --- Recording (LiveKit Egress -> S3-compatible storage) ----------------------
RECORDING_ENABLED=false
RECORDING_S3_ENDPOINT=http://localhost:9000
RECORDING_BUCKET=recordings
RECORDING_ACCESS_KEY=
RECORDING_SECRET_KEY=
RECORDING_REGION=us-east-1
RECORDING_PREFIX=recordings

# --- WhatsApp Calling channel (Meta Cloud API) --------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_AGENT_ID=mock-demo

# --- Cost overrides (optional): PRICE_<PROVIDER>_<UNIT>=usd_per_unit ----------
# PRICE_DEEPGRAM_AUDIO_SECONDS=0.0000722
